    <string name="nav_servers">Servers</string>
    <string name="servers_mode_auto">Automatic</string>
    <string name="servers_mode_manual">Chosen by hand</string>
    <string name="servers_auto_explained">The proxy picks servers itself, using the require_dnssec, require_nolog and require_nofilter filters from the config.</string>
    <string name="servers_active_title">Current server</string>
    <string name="servers_active_hint">This line appears in the proxy log only after a successful start.</string>
