    <string name="setting_redirect_ipv4">Redirect IPv4 DNS</string>
    <string name="setting_redirect_ipv4_desc">The main mode: sends IPv4 DNS traffic through the local proxy.</string>
    <string name="setting_redirect_ipv6">IPv6 DNS</string>
    <string name="setting_redirect_ipv6_desc">Auto only redirects when the kernel can do ip6tables nat.</string>
    <string name="setting_tether">Redirect hotspot DNS</string>
    <string name="setting_tether_desc">Also sends queries from devices on your hotspot through the proxy. Off by default: touching tethering has broken Wi-Fi sharing in the past.</string>
    <string name="setting_private_dns">Turn off Private DNS</string>
    <string name="setting_private_dns_desc">System Private DNS goes over DoT and bypasses port 53, so the module cannot intercept it.</string>
    <string name="setting_mirror">Mirror the config</string>
    <string name="setting_mirror_desc">Keeps a copy of the config in internal storage for editing.</string>
    <string name="setting_restart_delay">Restart delay cap</string>
    <string name="setting_restart_delay_desc">Longest pause between attempts to bring a crashed proxy back up.</string>

