    <!-- Advanced settings -->
    <string name="settings_advanced_header">Advanced</string>
    <string name="setting_run_gid">Process group</string>
    <string name="setting_run_gid_desc">Only needed with box_for_magisk installed: it lets traffic owned by root:net_admin past its own interception, and without this the proxy queries to resolvers go back through box.</string>
    <string name="run_gid_default">Default</string>
    <string name="run_gid_custom">Custom value</string>
    <string name="run_gid_custom_label">GID or group name</string>
    <string name="run_gid_invalid">Digits only, or a group name of letters and underscores.</string>
    <string name="servers_applied">Server list applied, proxy restarted</string>
    <string name="servers_more_results">First %1$d of %2$d — narrow the search</string>
    <string name="settings_reset">Reset to defaults</string>
    <string name="settings_reset_title">Reset module settings?</string>
    <string name="settings_reset_message">Every module setting goes back to the value the module ships with. The current ones are saved next to module.conf as a .bak first. The proxy restarts.</string>
    <string name="settings_reset_done">Settings reset to defaults, proxy restarted</string>
    <string name="setting_autostart">Start at boot</string>
    <string name="setting_autostart_desc">Off keeps the module installed but asleep: after a reboot it starts nothing and installs no intercept rules. You can still start it by hand here or from the quick settings tile.</string>

