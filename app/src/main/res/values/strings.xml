    <string name="servers_selected_title">Chosen</string>
    <string name="servers_selected_empty">Nothing chosen. An empty list means the same as automatic.</string>
    <string name="servers_order_hint">Order matters: the proxy tries them top to bottom. Tap a chip, then use the arrows.</string>
    <string name="servers_move_up">Move earlier</string>
    <string name="servers_move_down">Move later</string>
    <string name="servers_unknown_chip">Not in the list</string>
    <string name="servers_unknown_note">Marked servers are missing from the cached list. That is allowed: the name may come from elsewhere.</string>
    <string name="servers_cache_missing_title">Resolver list not downloaded yet</string>
    <string name="servers_cache_missing_body">The list appears after the proxy first starts with a working network. The proxy downloads it itself and checks the minisign signature, so the app does not fetch it.</string>
    <string name="servers_cache_stale">The cached list is over a week old. The proxy refreshes it on its own.</string>
    <string name="servers_empty_title">Switch to automatic?</string>
    <string name="servers_empty_message">The list is empty, which means the same as automatic selection. The proxy will pick servers by the require_* filters.</string>
    <string name="servers_unsupported_title">Module is too old for this</string>
    <string name="servers_unsupported_body">Choosing resolvers needs module %1$s or newer, which is where dnscrypt-ctl servers first appears.</string>
