    <string name="status_ipv6_bypass_title">IPv6 DNS bypasses the proxy</string>
    <string name="status_ipv6_bypass_body">This kernel cannot redirect IPv6, so queries to the network\'s IPv6 resolver are neither encrypted nor filtered. Update the module: newer versions block IPv6 DNS here so the system falls back to IPv4.</string>

