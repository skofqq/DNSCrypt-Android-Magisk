<?xml version="1.0" encoding="utf-8"?>
<!-- Splash: the shield pops in, then "DNS" is written letter by letter (about 800 ms). -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector android:width="108dp" android:height="108dp" android:viewportWidth="108" android:viewportHeight="108">
            <!-- Accent disc drawn here rather than via windowSplashScreenIconBackgroundColor, which this emulator ignored. -->
            <path android:pathData="M54,18 a36,36 0 1,0 0.01,0 Z" android:fillColor="#FF0969DA" />
            <group android:name="shield" android:pivotX="54" android:pivotY="54" android:scaleX="0.5" android:scaleY="0.5">
                <path android:name="shield_fill" android:pathData="M54,25 L79,33.5 V52 C79,65.5 68.5,76 54,83 C39.5,76 29,65.5 29,52 V33.5 Z" android:fillColor="#FFFFFFFF" android:fillAlpha="0" />
                <group android:translateY="-1">
            <path android:name="letter_d" android:pathData="M38.5,47.5 V60.5 H41 C45.5,60.5 47,57.5 47,54 C47,50.5 45.5,47.5 41,47.5 Z" android:strokeColor="#FF0969DA" android:strokeWidth="3.4" android:strokeLineCap="round" android:strokeLineJoin="round" android:trimPathEnd="0" />
            <path android:name="letter_n" android:pathData="M51,60.5 V47.5 L58,60.5 V47.5" android:strokeColor="#FF0969DA" android:strokeWidth="3.4" android:strokeLineCap="round" android:strokeLineJoin="round" android:trimPathEnd="0" />
            <path android:name="letter_s" android:pathData="M70,49.6 C69.2,48.2 67.8,47.5 66,47.5 C63.6,47.5 62,48.9 62,50.8 C62,54.6 70,53.2 70,57.2 C70,59.2 68.4,60.5 66,60.5 C64.2,60.5 62.8,59.8 62,58.4" android:strokeColor="#FF0969DA" android:strokeWidth="3.4" android:strokeLineCap="round" android:strokeLineJoin="round" android:trimPathEnd="0" />
                </group>
            </group>
        </vector>
    </aapt:attr>
    <target android:name="shield">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="scaleX" android:valueFrom="0.5" android:valueTo="0.84" android:duration="360" android:interpolator="@android:interpolator/overshoot" />
                <objectAnimator android:propertyName="scaleY" android:valueFrom="0.5" android:valueTo="0.84" android:duration="360" android:interpolator="@android:interpolator/overshoot" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="shield_fill">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="fillAlpha" android:valueFrom="0" android:valueTo="1" android:duration="240" />
        </aapt:attr>
    </target>
    <target android:name="letter_d">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="trimPathEnd" android:valueFrom="0" android:valueTo="1"
                android:startOffset="300" android:duration="260" android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>
    <target android:name="letter_n">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="trimPathEnd" android:valueFrom="0" android:valueTo="1"
                android:startOffset="450" android:duration="260" android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>
    <target android:name="letter_s">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="trimPathEnd" android:valueFrom="0" android:valueTo="1"
                android:startOffset="600" android:duration="260" android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>
</animated-vector>
