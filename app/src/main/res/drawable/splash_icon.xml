<?xml version="1.0" encoding="utf-8"?>
<!-- Splash: the shield pops in on a slate disc, the links are drawn, then the three
     resolver nodes pop in one by one (about 750 ms). -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector android:width="108dp" android:height="108dp" android:viewportWidth="108" android:viewportHeight="108">
            <!-- Disc drawn here rather than via windowSplashScreenIconBackgroundColor, which this emulator ignored. -->
            <path android:pathData="M54,18 a36,36 0 1,0 0.01,0 Z">
                <aapt:attr name="android:fillColor">
                    <gradient android:type="linear" android:startX="18" android:startY="18" android:endX="90" android:endY="90">
                        <item android:offset="0" android:color="#FF111827" />
                        <item android:offset="1" android:color="#FF1E293B" />
                    </gradient>
                </aapt:attr>
            </path>
            <group android:name="shield" android:pivotX="54" android:pivotY="54" android:scaleX="0.5" android:scaleY="0.5">
                <path android:name="shield_fill"
                    android:pathData="M54,26 L76,34 V52 C76,67 66,78 54,83 C42,78 32,67 32,52 V34 Z"
                    android:fillAlpha="0">
                    <aapt:attr name="android:fillColor">
                        <gradient android:type="linear" android:startX="32" android:startY="26" android:endX="76" android:endY="83">
                            <item android:offset="0" android:color="#FF38BDF8" />
                            <item android:offset="1" android:color="#FF6366F1" />
                        </gradient>
                    </aapt:attr>
                </path>
                <path android:pathData="M54,26 L54,83 C42,78 32,67 32,52 V34 Z" android:fillColor="#1FFFFFFF" />
                <path android:name="links"
                    android:pathData="M54,45 L45,62 L63,62 Z"
                    android:strokeColor="#FFFFFFFF" android:strokeWidth="2.6"
                    android:strokeLineCap="round" android:strokeLineJoin="round"
                    android:trimPathEnd="0" />
                <group android:name="node_top" android:pivotX="54" android:pivotY="45" android:scaleX="0" android:scaleY="0">
                    <path android:pathData="M54,41 a4,4 0 1,0 0.01,0 Z" android:fillColor="#FFFFFFFF" />
                </group>
                <group android:name="node_left" android:pivotX="45" android:pivotY="62" android:scaleX="0" android:scaleY="0">
                    <path android:pathData="M45,58 a4,4 0 1,0 0.01,0 Z" android:fillColor="#FFFFFFFF" />
                </group>
                <group android:name="node_right" android:pivotX="63" android:pivotY="62" android:scaleX="0" android:scaleY="0">
                    <path android:pathData="M63,58 a4,4 0 1,0 0.01,0 Z" android:fillColor="#FFFFFFFF" />
                </group>
            </group>
        </vector>
    </aapt:attr>
    <target android:name="shield">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="scaleX" android:valueFrom="0.5" android:valueTo="0.9" android:duration="360" android:interpolator="@android:interpolator/overshoot" />
                <objectAnimator android:propertyName="scaleY" android:valueFrom="0.5" android:valueTo="0.9" android:duration="360" android:interpolator="@android:interpolator/overshoot" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="shield_fill">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="fillAlpha" android:valueFrom="0" android:valueTo="1" android:duration="240" />
        </aapt:attr>
    </target>
    <target android:name="links">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="trimPathEnd" android:valueFrom="0" android:valueTo="1"
                android:startOffset="260" android:duration="300" android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>
    <target android:name="node_top">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="scaleX" android:valueFrom="0" android:valueTo="1" android:startOffset="340" android:duration="220" android:interpolator="@android:interpolator/overshoot" />
                <objectAnimator android:propertyName="scaleY" android:valueFrom="0" android:valueTo="1" android:startOffset="340" android:duration="220" android:interpolator="@android:interpolator/overshoot" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="node_left">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="scaleX" android:valueFrom="0" android:valueTo="1" android:startOffset="440" android:duration="220" android:interpolator="@android:interpolator/overshoot" />
                <objectAnimator android:propertyName="scaleY" android:valueFrom="0" android:valueTo="1" android:startOffset="440" android:duration="220" android:interpolator="@android:interpolator/overshoot" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="node_right">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="scaleX" android:valueFrom="0" android:valueTo="1" android:startOffset="540" android:duration="220" android:interpolator="@android:interpolator/overshoot" />
                <objectAnimator android:propertyName="scaleY" android:valueFrom="0" android:valueTo="1" android:startOffset="540" android:duration="220" android:interpolator="@android:interpolator/overshoot" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
